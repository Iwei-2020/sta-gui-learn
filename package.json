{
  "name": "sta-gui",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "author": "maxinyue <maxinyue@raina.tech>",
  "main": "app/master-compiled/main.js",
  "scripts": {
    "build-electron": "electron-builder --linux",
    "build-master": "tsc -p ./app/tsconfig.json",
    "build-umi": "cross-env NODE_ENV=production max build",
    "dev": "node ./scripts/dev.js",
    "postinstall": "max setup && electron-builder install-app-deps",
    "package": "npm run build-master && npm run build-umi && npm run build-electron",
    "setup": "max setup"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@umijs/max": "^4.4.12",
    "antd": "^5.27.0",
    "d3": "^7.9.0",
    "flexlayout-react": "^0.8.17",
    "http-server": "^14.1.1",
    "lodash": "^4.17.21",
    "mobx": "^6.13.7",
    "mobx-react": "^9.2.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^33",
    "electron-builder": "^24.6.3",
    "electron-reload": "^2.0.0-alpha.1",
    "typescript": "^5.0.3"
  },
  "build": {
    "productName": "RainaStaGui",
    "appId": "com.raina.sta.gui",
    "executableName": "RainaStaGui",
    "artifactName": "${productName}.${ext}",
    "files": [
      "**/*",
      "!master/"
    ],
    "linux": {
      "executableName": "RainaStaGui",
      "publish": [],
      "target": [
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": "x64"
        }
      ]
    },
    "directories": {
      "output": "dist"
    }
  },
  "overrides": {
    "@ant-design/charts": {
      "antd": "^5.4.7",
      "@ant-design/icons": "5.0.1"
    }
  },
  "rainaConfig": {
    "type": "electron"
  }
}
